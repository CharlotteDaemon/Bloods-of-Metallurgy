        "parts": {
            "royalty": {
                "": "Glyph of Royalty",
                "description": "Reduces a metal or blood to a lower tier, spits out the leftovers as the equivalent blood."
            },
            "divergence": {
                "": "Glyph of Divergence",
                "description": "Splits a metal or blood into two lower metals or bloods."
            },
            "coronation": {
                "": "Glyph of Coronation",
                "description": "Projects two matching bloods."
            },
            "promotion": {
                "": "Glyph of Promotion",
                "description": "Projects a metal up as many tiers as the provided blood is capable of, outputting the remainder if necessary."
            },
            "insurrection": {
                "": "Glyph of Insurrection",
                "description": "Swaps the metallicities of any metal with any of the bloods."
            }

        },
